{
  "name": "@dodi-smart/runner-fallback-action",
  "version": "2.0.0",
  "description": "GitHub Action that checks self-hosted runner availability and falls back to GitHub-hosted runners when needed",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "ncc build src/main.ts -o dist --source-map --license licenses.txt",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "typecheck": "tsc --noEmit",
    "all": "npm run lint && npm run format:check && npm run typecheck && npm test && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dodi-smart/runner-fallback-action.git"
  },
  "keywords": [
    "github",
    "actions",
    "runner",
    "self-hosted",
    "fallback"
  ],
  "author": "Asen Lekov <asenlekoff@gmail.com> (https://github.com/azlekov)",
  "contributors": [
    {
      "name": "Mike Hardy",
      "email": "github@mikehardy.net",
      "url": "https://github.com/mikehardy"
    },
    {
      "name": "Jimmy Chen",
      "email": "jchen.tc@gmail.com",
      "url": "https://github.com/jimmygchen"
    }
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/dodi-smart/runner-fallback-action/issues"
  },
  "homepage": "https://github.com/dodi-smart/runner-fallback-action#readme",
  "dependencies": {
    "@actions/core": "^1.11.1",
    "@actions/http-client": "^3.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.7.0",
    "@vercel/ncc": "^0.38.4",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^16.5.0",
    "jest": "^30.2.0",
    "prettier": "^3.4.2",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.18.0"
  },
  "packageManager": "yarn@4.10.3+sha512.c38cafb5c7bb273f3926d04e55e1d8c9dfa7d9c3ea1f36a4868fa028b9e5f72298f0b7f401ad5eb921749eb012eb1c3bb74bf7503df3ee43fd600d14a018266f"
}
